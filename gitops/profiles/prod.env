# 规模/环境 profile：prod（M 档，数据/工具链可拆）
# 用法（规划）：make <target> $(cat profiles/prod.env | xargs)
# 说明：模板。生产建议独立数据集群(B)；存储=云盘，备份出口=S3(OSS)。
DOMAIN=baokuaiyun.com
CLUSTER_ROLE=mgmt
STORAGE_BACKEND=alicloud
STORAGE_CLASS=app-storage
SNAPSHOT_CLASS=alicloud-disk
GITLAB_OBJECT_STORE=oss
# 数据平面（独立集群 B，云无关）
# PG_INSTANCES=3
# PG_SYNC_REPLICAS=1
# REDIS_CLUSTER_SIZE=3
# 备份出口（S3 兼容）
# PG_BACKUP_BUCKET=<bucket>
# S3_ENDPOINT=<s3-endpoint>

# 引导/GitOps 平面控制
TOOLCHAIN_MODE=selfhost      # mgmt 集群自托管 Harbor/Git 供成员依赖
ENABLE_FLUX=true
DATA_SOURCE=shared           # 成员默认依赖本数据平面（可按应用覆盖）
GIT_MODE=later
CLUSTER_TYPE=A
