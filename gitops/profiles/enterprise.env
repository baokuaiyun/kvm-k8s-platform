# 规模/环境 profile：enterprise（L 档，强隔离）
# 说明：模板。租户用 Mode C(vCluster) / 独立控制面；数据独立集群/托管实例；
#       合规要求：审计、密钥 KMS、跨区复制、异地 PITR。
DOMAIN=baokuaiyun.com
CLUSTER_ROLE=workload
STORAGE_BACKEND=alicloud
STORAGE_CLASS=app-storage
SNAPSHOT_CLASS=alicloud-disk
GITLAB_OBJECT_STORE=oss
# 强隔离租户：Mode C
# TENANCY_MODE=vcluster
# 数据：专用集群/托管实例
# DB_PROFILE=db-l

# 引导/GitOps 平面控制
TOOLCHAIN_MODE=consume       # 消费外部/本 Harbor/Git
ENABLE_FLUX=true
DATA_SOURCE=shared
GIT_MODE=later
CLUSTER_TYPE=B
