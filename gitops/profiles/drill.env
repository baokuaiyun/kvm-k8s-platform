# 规模/环境 profile：drill（S 档，all-in-one）
# 用法（规划）：make <target> $(cat profiles/drill.env | xargs)
# 说明：本文件为模板，供 variables.mk 覆盖；当前 drill 实际值见 variables.mk / acr.env。
DOMAIN=test.baokuaiyun.com
CLUSTER_ROLE=all-in-one
STORAGE_BACKEND=longhorn
STORAGE_CLASS=app-storage
SNAPSHOT_CLASS=longhorn
GITLAB_OBJECT_STORE=minio

# 引导/GitOps 平面控制
TOOLCHAIN_MODE=selfhost      # 自托管 Harbor/Git
ENABLE_FLUX=true
DATA_SOURCE=local            # 应用数据来源: local | shared
GIT_MODE=later               # Git/CI 后置
CLUSTER_TYPE=all
