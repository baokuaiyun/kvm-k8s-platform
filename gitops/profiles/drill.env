# 规模/环境 profile：drill（S 档，all-in-one）
# 用法：make <target> ENV=drill   （由顶层 Makefile -include 自动加载本文件）
# 说明：本文件覆盖 variables.mk 的 G 默认值（P 层）；密钥仍在 acr.env（S 层，优先级最高）。
DOMAIN=test.baokuaiyun.com
CLUSTER_ROLE=all-in-one
# 云盘/计算分离：宿主 ZFS+iSCSI 提供 app-storage（模拟阿里云云盘）
STORAGE_BACKEND=host-zfs-iscsi
STORAGE_CLASS=app-storage
SNAPSHOT_CLASS=host-zfs-iscsi
# 对象/备份层：宿主 MinIO（docker）模拟 OSS
GITLAB_OBJECT_STORE=host-minio
# 起步规模：单节点（如需 1CP+1W 覆盖 WK_INIT_COUNT=1）
WK_INIT_COUNT=0

# 引导/GitOps 平面控制
TOOLCHAIN_MODE=selfhost      # 自托管 Harbor/Git
ENABLE_FLUX=true
DATA_SOURCE=local            # 应用数据来源: local | shared
GIT_MODE=later               # Git/CI 后置
CLUSTER_TYPE=all

# 节点/网络与 LB IP（KVM 同二层：kube-vip 持 CP_VIP，Cilium LB IPAM + L2 发服务 IP）
NODE_IP_MODE=static
LB_IP_MODE=cilium-l2
LB_POOL_START=192.168.124.40
LB_POOL_END=192.168.124.79
GATEWAY_VIP=192.168.124.31
LB_ANNOUNCE=l2
LB_CLASS=
