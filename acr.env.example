# ACR 凭据与参数 —— 复制为 acr.env（已在 .gitignore）后填真实值
# 用法: cp acr.env.example acr.env && vim acr.env
#       （也可直接用同名环境变量覆盖）

# 源 ACR
ACR_REGISTRY=crpi-adznwq8xa40ei174.cn-hangzhou.personal.cr.aliyuncs.com
ACR_NAMESPACE=baokuaiyun

# 认证方式: password | ak | none
ACR_AUTH_MODE=password
ACR_USER=<真实 ACR 用户名>
ACR_PASS=<真实 ACR 密码>

# 镜像来源: auto | acr | upstream
#   auto     = 先试 ACR，缺失回退上游
#   acr      = 只从 ACR 拉
#   upstream = 只从上游（registry.k8s.io / quay.io / ghcr.io / docker.io）拉
ACR_SOURCE=auto

# ---------- 云效（Yunxiao）----------
# 组织管理后台 → 基本信息 取 organizationId
YUNXIAO_ORG_ID=<云效组织ID>
# 云效 → 个人设置 → 个人访问令牌
YUNXIAO_TOKEN=pt-xxxxxxxx

# ---------- Helm Chart 仓库 ----------
# 注意：云效制品仓库不支持 Helm；引导期用 云效 Codeup Git 托管 chart。
# HELM_REPO_URL 留空（保留兼容）；实际走下方 HELM_GIT_*。
HELM_REPO_NAME=baokuaiyun
HELM_REPO_URL=
HELM_REPO_USER=<云效账号邮箱>
HELM_REPO_PASS=<个人访问令牌 pt-...>
HELM_CHARTS_DIR=/data/kvm/charts

# 引导期 chart 源：云效 Codeup Git
HELM_GIT_URL=https://codeup.aliyun.com/<orgId>/baokuaiyun/helm-charts.git
HELM_GIT_USER=<云效账号邮箱>
HELM_GIT_TOKEN=pt-xxxxxxxx
HELM_GIT_REF=main
HELM_GIT_DIR=/data/kvm/helm-charts

# ---------- IdP: Casdoor（集群内）----------
CASDOOR_VERSION=latest
CASDOOR_DB_USER=casdoor
CASDOOR_DB_PASS=<强密码>
CASDOOR_DB_NAME=casdoor

# ---------- 共享平台数据（platform-data: CNPG + redis-operator）----------
# 各角色/Redis 密码；Casdoor 复用 PG_CASDOOR_PASS
PG_HARBOR_PASS=<强密码>
PG_GITLAB_PASS=<强密码>
PG_CASDOOR_PASS=<强密码>
REDIS_PASS=<强密码>
