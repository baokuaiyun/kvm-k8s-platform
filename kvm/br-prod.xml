<network xmlns:dnsmasq='http://libvirt.org/schemas/network/dnsmasq/1.0'>
  <name>br-prod</name>
  <forward mode="nat">
    <nat>
      <port start="1024" end="65535"/>
    </nat>
  </forward>
  <bridge name="br-prod" stp="on" delay="0"/>
  <ip address="192.168.124.1" netmask="255.255.255.0">
    <dhcp>
      <range start="192.168.124.100" end="192.168.124.200"/>
      <host name="k8s-cp-1" ip="192.168.124.10" mac="52:54:00:01:01:01"/>
      <host name="k8s-cp-2" ip="192.168.124.11" mac="52:54:00:01:01:02"/>
      <host name="k8s-cp-3" ip="192.168.124.12" mac="52:54:00:01:01:03"/>
      <host name="k8s-worker-1" ip="192.168.124.20" mac="52:54:00:01:02:01"/>
      <host name="k8s-worker-2" ip="192.168.124.21" mac="52:54:00:01:02:02"/>
    </dhcp>
  </ip>

  <!-- 内网 DNS 域：节点短名/ FQDN 本地解析，不向公网转发 -->
  <domain name='test.baokuaiyun.com' localOnly='yes'/>

  <!--
    自定义 DNS 记录（libvirt 内置 dnsmasq 渲染）
    - k8s-api  : control-plane-endpoint 域名 → kube-vip 持有的 CP_VIP（本仓用 kube-vip，非 keepalived）
    - 可选预留  : harbor/gitlab/grafana 指向集群入口 VIP
  -->
  <dnsmasq:options>
    <dnsmasq:option value='host-record=k8s-api.test.baokuaiyun.com,192.168.124.30'/>
    <dnsmasq:option value='host-record=casdoor.test.baokuaiyun.com,192.168.1.235'/>
    <dnsmasq:option value='host-record=harbor.test.baokuaiyun.com,192.168.1.235'/>
    <dnsmasq:option value='host-record=gitlab.test.baokuaiyun.com,192.168.1.235'/>
    <dnsmasq:option value='host-record=grafana.test.baokuaiyun.com,192.168.1.235'/>
    <dnsmasq:option value='host-record=argocd.test.baokuaiyun.com,192.168.1.235'/>
  </dnsmasq:options>
</network>
