# 运维客户端环境参数（复制为 ops.env；已被 .gitignore 忽略，勿提交）
# 用法：
#   1) cp ops.env.example ops.env && vim ops.env
#   2) make alerts                      # 自动导入 ops.env
#      或  source ops.env && make alerts
#      或  ALERT_ENV_FILE=/path/ops.env bash observability/apply-alerts.sh
# 说明：本文件为 shell KEY=VALUE；由 make（-include ops.env）与应用脚本（source）共同读取，
#       优先级：ops.env > acr.env/variables.mk 默认。值含空格请用引号。

# ---------- 告警通知（Alertmanager） ----------
# 渠道类型: generic | slack | dingtalk | wecom
ALERT_WEBHOOK_ENABLED=0
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TYPE=generic
# warning 走哪些渠道: all | email
ALERT_WARNING_CHANNELS=all

# 邮件（SMTP）
ALERT_EMAIL_ENABLED=0
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
SMTP_SMARTHOST=
SMTP_AUTH_USERNAME=
SMTP_AUTH_PASSWORD=

# 钉钉集群内适配器（可选；make alert-adapter 用）
ALERT_DINGTALK_WEBHOOK=
ALERT_DINGTALK_SECRET=
